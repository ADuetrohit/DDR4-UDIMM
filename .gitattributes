* text=auto

# Altium Designer documents and libraries: never touch line endings
*.SchDoc   binary
*.PcbDoc   binary
*.SchLib   binary
*.PcbLib   binary
*.IntLib   binary
*.PrjPcb   text eol=crlf
*.OutJob   text eol=crlf

# Mechanical / images / fab data
*.step     binary
*.stp      binary
*.png      binary
*.jpg      binary
*.pdf      binary
*.zip      binary

# Altium Smart Paste needs Windows line endings
*.tsv      text eol=crlf
