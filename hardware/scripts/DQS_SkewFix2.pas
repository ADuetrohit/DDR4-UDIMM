        AddTrack(N, eMidLayer2, 31.3140, 9.0875, 31.4838, 9.2572);
        AddTrack(N, eMidLayer2, 31.4838, 9.2572, 31.4838, 9.3704);
        AddTrack(N, eMidLayer2, 31.4838, 9.3704, 31.2225, 9.6316);
