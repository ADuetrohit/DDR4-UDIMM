    Done := 0;
    PCBServer.PreProcess;
    { DQS2: NetR33_1, 2 bump(s) }
    N := TakeTrack('NetR33_1', eMidLayer2, 30.7028, 9.2250, 31.8796, 10.4018);
    If N <> Nil Then
